#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$repo/scripts/validate_agent_plugin.py" "$repo"
python3 "$repo/scripts/sync_openai_adapter.py" --check
python3 "$repo/scripts/validate_codex_plugin.py" "$repo/plugins/build-omarchy-apps"
python3 "$repo/scripts/validate_skills.py" --require-openai-metadata "$repo/plugins/build-omarchy-apps/skills"
python3 -m unittest discover -s "$repo/tests" -p 'test_*.py' -v
if [[ "${1:-}" != "--portable-only" ]]; then
  cargo fmt --manifest-path "$repo/skills/omarchy-app-scaffold/scripts/app-tool/Cargo.toml" -- --check
  cargo test --locked --manifest-path "$repo/skills/omarchy-app-scaffold/scripts/app-tool/Cargo.toml"
  cargo clippy --locked --manifest-path "$repo/skills/omarchy-app-scaffold/scripts/app-tool/Cargo.toml" --all-targets -- -D warnings
fi
